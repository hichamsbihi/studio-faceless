# Fins de ligne : normalisées dans le dépôt ; les scripts shell restent en LF, PowerShell en CRLF.
* text=auto
*.sh text eol=lf
.githooks/* text eol=lf
*.ps1 text eol=crlf

# Binaires (petits fichiers hors LFS, par exemple dans vendor/) : jamais traités comme du texte
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.mp3 binary
*.wav binary
*.mp4 binary
*.mov binary
*.webm binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary

# Git LFS : binaires indispensables de la marque (signature, outro, appels, logo, polices, matières, sons)
marque/**/*.mp4 filter=lfs diff=lfs merge=lfs -text
marque/**/*.mov filter=lfs diff=lfs merge=lfs -text
marque/**/*.wav filter=lfs diff=lfs merge=lfs -text
marque/**/*.mp3 filter=lfs diff=lfs merge=lfs -text
marque/**/*.png filter=lfs diff=lfs merge=lfs -text
marque/**/*.jpg filter=lfs diff=lfs merge=lfs -text
marque/**/*.ttf filter=lfs diff=lfs merge=lfs -text
